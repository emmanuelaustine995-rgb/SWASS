{
  "name": "swass-api",
  "version": "0.1.0",
  "private": true,
  "description": "SWASS business and receipt management API",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node src/main.ts",
    "migrate": "bash scripts/migrate.sh",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f test/db_rules.sql",
    "test:api": "node --test test/api.test.mjs",
    "migrate:node": "node scripts/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "argon2": "^0.41.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "pdfkit": "^0.15.0",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5"
  },
  "engines": {
    "node": ">=22"
  }
}
