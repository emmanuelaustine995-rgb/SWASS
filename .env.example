# Copy this file to .env for local development. Never commit .env.
# Example only: replace every value with your own private credentials.
DATABASE_URL=postgresql://swass_user:change_me@localhost:5432/swass
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
SWASS_ID_SECRET=replace_with_a_different_random_secret_at_least_32_characters
PORT=3000
# Comma-separated exact browser origins. Example: http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Optional: integer from 0 to 100; defaults to 5.
CASHIER_MAX_DISCOUNT_PCT=5

# Safaricom Daraja STK Push. Keep credentials private; use sandbox first.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS callback URL, including the secret callback token path.
MPESA_CALLBACK_URL=https://your-api-domain.example/api/v1/mpesa/callback/replace-with-a-long-random-token
MPESA_CALLBACK_TOKEN=replace-with-a-long-random-random-token
# Optional Twilio SMS delivery for OTP receipt recovery. Required in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
